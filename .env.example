# ============================================
# Task Management API - Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# --- Authentication ---
JWT_SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- PostgreSQL ---
POSTGRES_USER=taskman
POSTGRES_PASSWORD=taskman_secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Service Databases ---
AUTH_DB_NAME=auth_db
TASK_DB_NAME=task_db
AUDIT_DB_NAME=audit_db

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Jaeger (OpenTelemetry) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# --- Service Ports ---
AUTH_SERVICE_PORT=8001
TASK_SERVICE_PORT=8002
AUDIT_SERVICE_PORT=8003

# --- Frontend ---
VITE_API_URL=http://localhost
